# ── Laorvia Spring Boot 4.1.2 security secrets ───────────────────────────────
# Generate once per environment, store in a secret manager / KMS, never commit.
#   openssl rand -base64 32        → LAORVIA_SECURITY_KEK
#   openssl rand -base64 48        → LAORVIA_SECURITY_IP_PEPPER
LAORVIA_SECURITY_KEK=
LAORVIA_SECURITY_IP_PEPPER=

# ── Network ──────────────────────────────────────────────────────────────────
LAORVIA_TLS_REQUIRED=true
LAORVIA_TRUSTED_PROXY_COUNT=1
LAORVIA_IP_BINDING_MODE=STRICT
LAORVIA_ALLOWED_ORIGINS=https://laorvia.com,https://www.laorvia.com

# NEVER enable these in production
LAORVIA_ALLOW_EPHEMERAL_KEK=false
LAORVIA_DEMO_LOGIN=false

# ── Redis (TLS + ACL) ────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=laorvia-api
REDIS_PASSWORD=
REDIS_SSL=true
